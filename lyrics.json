    {
      "start": 1.39,
      "end": 6.90,
      "text": "Akhiyan de samnay tu baitha rawein der tak",
      "anim": "words",
      "scene": "night",
      "highlight": ["Akhiyan", "tu"]
    },
    {
      "start": 7.46,
      "end": 13.04,
      "text": "Vekhaan tennu raat saari, charhdi saveer tak",
