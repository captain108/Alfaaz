      "scene": "dusk",
      "highlight": ["raat saari", "saveer"]
    },
    {
      "start": 13.42,
      "end": 18.96,
      "text": "Baaghan vicho main te torrey tere layi gulaab ve",
      "anim": "words",
      "scene": "rose",
      "highlight": ["gulaab"]
    },
    {
      "start": 19.38,
      "end": 24.40,
      "text": "Main te bas kehnda rehnda, aap janab ve",
      "anim": "words",
      "scene": "rose",
      "highlight": ["janab"]
    },
    {
      "start": 24.68,
      "end": 27.36,
      "text": "Tu te taareyaan ton vi sohna ay",
      "anim": "zoom",
      "scene": "dusk",
      "highlight": ["sohna"]
    },
    {
      "start": 27.66,
      "end": 30.37,
      "text": "Tere varga koi na hona ay",
      "anim": "kinetic",
      "scene": "crimson",
      "highlight": ["koi na"]
    },
    {
      "start": 30.62,
      "end": 33.28,
      "text": "Tu te taareyaan ton vi sohna ay",
      "anim": "zoom",
      "scene": "dusk",
      "highlight": ["sohna"]
    },
    {
      "start": 33.66,
      "end": 36.44,
      "text": "Tere varga koi na hona ay",
